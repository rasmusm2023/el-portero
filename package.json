{
  "name": "el-portero",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run dev:freeport && next dev -p 3000",
    "dev:freeport": "kill-port 3000",
    "dev:turbo": "next dev -p 3000 --turbo",
    "dev:clean": "npm run clean && next dev -p 3000",
    "build": "node ./scripts/assert-netlify-firebase-env.mjs && next build",
    "clean": "rm -rf .next .next-dev node_modules/.cache",
    "rebuild": "npm run clean && npm run build",
    "start": "next start -p 3000",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.487.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.2"
  }
}
