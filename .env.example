# Copy to `.env.local` and fill in. Never commit secrets.

# Instagram Graph API — Business/Creator account linked to a Facebook Page.
# Long-lived Page access token + Instagram Business Account ID (numeric).
# See comments in `src/lib/instagramGraphFeed.ts` for Meta setup steps.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Firebase (client) — from Firebase Console → Project settings → Your apps → Web app.
# Copy to `.env.local`. Used for admin sign-in (Authentication) and future Firestore reads/writes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
