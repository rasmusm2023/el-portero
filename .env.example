# Copy to `.env.local` and fill in. Never commit secrets.

# Instagram Graph API — Business/Creator account linked to a Facebook Page.
# Long-lived Page access token + Instagram Business Account ID (numeric).
# See comments in `src/lib/instagramGraphFeed.ts` for Meta setup steps.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Firebase (client) — from Firebase Console → Project settings → Your apps → Web app.
# Copy to `.env.local`. Used for admin auth, Firestore (events, lunch menu), etc.
#
# Firestore: deploy `firestore.rules` + `firestore.indexes.json` (see `firebase.json`) to the SAME project
# as your NEXT_PUBLIC_FIREBASE_* vars. Home + /events read `publicEvents` in the browser (published only).
# If you skip deploy, Firestore defaults to deny → “Missing or insufficient permissions.”
#
# Server-only (optional): Firebase service account JSON (Console → Project settings → Service accounts).
# Enables `GET /api/public/events` so published events load without fixing anonymous Firestore rules.
# — Never use a NEXT_PUBLIC_* name (that would bundle the key to browsers — catastrophic).
# — Same trust model as any server secret (DB URL, Stripe secret): keep in hosting env / secrets manager,
#   not in git; use a dedicated account with minimal IAM (e.g. Cloud Datastore User), not project Owner.
# — If you omit this, the app falls back to the browser Firestore client; then you must deploy tight rules
#   in `firestore.rules` so only published `publicEvents` are readable anonymously.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: protect `GET /api/public/events/diagnostics` in production (?key=... or header x-events-diagnostics).
# In `next dev`, diagnostics work without this.
EVENTS_DIAGNOSTICS_SECRET=

# Public teaser lock — set `1`/`true` on Netlify Production for el-portero.com.
# — Locks `/` to Coming soon, hides chrome, redirects other pages to `/` (still allows `/admin`, `/api/*`).
# — On localhost / 127.0.0.1 / *.hostnames ending in `.local`, the FULL site loads even if this is `1` (easier prod-like .env.local).
NEXT_PUBLIC_COMING_SOON=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
